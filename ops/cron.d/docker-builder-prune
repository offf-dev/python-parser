# Чистка docker build cache: держим кэш в пределах 3 ГБ.
# Ежедневно, т.к. каждая пересборка парсера (Playwright+Chromium) кладёт ~1.2 ГБ.
# Фильтр until= здесь не годится: кэш парсера пересобирается на каждом пуше и
# всегда "свежий", под него не попадал — крон освобождал 0 байт.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 4 * * * root sh -c 'date -Is; docker builder prune -f --max-used-space 3GB | tail -1' >> /var/log/docker-builder-prune.log 2>&1
