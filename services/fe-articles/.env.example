# Скопировать в .env и подставить реальные значения.
# ВАЖНО: настоящие токены/пароли сюда не коммитить — файл в git.

# Бот-публикатор: шлёт статьи в боевой канал
TG_BOT_TOKEN_FOR_ARTICLES=<bot_token>
TG_CHAT_ID_FOR_ARTICLES=<channel_id>

# Бот алертов: ошибки парсера и уведомления в админ-чат
TG_BOT_TOKEN_FOR_LOGS=<bot_token>
TG_CHAT_ID_FOR_LOGS=<chat_id>

# Сводки цикла парсинга. Если не задать — уйдут в articles-канал articles-ботом.
# TG_CHAT_ID_FOR_SUMMARY=<channel_id>
# TG_BOT_TOKEN_FOR_SUMMARY=<bot_token>
# ENABLE_PARSE_SUMMARY=true

PARSER_INTERVAL_MINUTES=60
SENDER_INTERVAL_MINUTES=10

APP_ENV=production
PORT=5000

# Гибридный режим
USE_DB_FOR_RESOURCES=true      # false = из resources.json
USE_DB_FOR_ARTICLES=true       # false = из last_results.json

# READONLY_DB=true — читать из БД можно, писать нельзя (новые статьи уходят
# в канал как PREVIEW вместо сохранения в links). Удобно для локального теста.
# READONLY_DB=false

# Подключение к MySQL (Cityhost)
DB_CONNECTION=mysql
DB_HOST=<db_host>
DB_PORT=3306
DB_DATABASE=<db_name>
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>
